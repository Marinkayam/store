# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only. לעולם לא בקוד לקוח

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=duchan-media
NEXT_PUBLIC_R2_PUBLIC_URL=      # https://media.duchan.co
# R2_ENDPOINT=                  # override אופציונלי — לבדיקות מקומיות / ספק S3 אחר

# כניסה בסמס — sms4free.co.il
# בלי אלה מסך הכניסה מחזיר 503 ואי אפשר להירשם בכלל.
SMS4FREE_KEY=
SMS4FREE_USER=                  # מספר הנייד שאיתו נרשמת לספק
SMS4FREE_PASS=
SMS4FREE_SENDER=                # עד 11 תווים. עם 10 ההודעות החינמיות חייב להיות מספר הנייד שנרשמת איתו.

# אדמין — אימיילים מופרדים בפסיק
ADMIN_EMAILS=

# סוד לקרון היומי (גיבוי + פינג)
CRON_SECRET=

# התראות טלגרם למרינה — חנות חדשה נפתחה / ילדה הצהירה ששילמה ומחכה
# לאישור. בלי אלה פשוט לא נשלחות התראות, שום דבר לא נשבר.
# TELEGRAM_BOT_TOKEN — נוצר דרך @BotFather בטלגרם (/newbot)
# TELEGRAM_CHAT_ID — ה-chat id של מרינה, ראו docs/telegram-setup.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# הפעלת חנות — תשלום חד-פעמי. הילדה בונה בחינם; הלינק נפתח בהפעלה.
NEXT_PUBLIC_ACTIVATION_PRICE=200
# מחיר השקה + סוף המבצע (סוף היום בישראל). אחרי התאריך המחיר חוזר לבד
# למחיר המלא — אין מה לזכור לשנות.
NEXT_PUBLIC_LAUNCH_PRICE=50
NEXT_PUBLIC_LAUNCH_UNTIL=2026-07-30T20:59:59Z
# המספר שמופיע בתחתית כל דוכן, ל"רוצה גם דוכן כזה?". מספר עסקי, גלוי
# בכוונה. ברירת המחדל בקוד היא 972545888471.
NEXT_PUBLIC_SALES_WHATSAPP=972545888471
NEXT_PUBLIC_OWNER_WHATSAPP=      # E.164 בלי + (972…) — לביט ידני ולשיחה עם המנהלת
NEXT_PUBLIC_PAY_BIT_URL=         # לינק תשלום אישי בביט (אופציונלי)
NEXT_PUBLIC_PAY_PAYBOX_URL=      # לינק תשלום אישי בפייבוקס (אופציונלי)

# פיצ'ר פרימיום: כתיבת תיאורי מוצר ע"י AI (אופציונלי)
ANTHROPIC_API_KEY=
AI_MODEL=                       # ברירת מחדל claude-opus-5; claude-haiku-4-5 זול פי ~5

# הכתובת הפומבית — נדרשת לתצוגה מקדימה בוואטסאפ (OpenGraph)
NEXT_PUBLIC_SITE_URL=https://duchan.app

# כתובת יצירת קשר בתנאי השימוש ובמדיניות הפרטיות
NEXT_PUBLIC_CONTACT_EMAIL=hello@duchan.app

NEXT_PUBLIC_SQUISH_PARENT_APPROVAL=
NEXT_PUBLIC_SQUISH_FOF_LIMITED=
