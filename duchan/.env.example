# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only. לעולם לא בקוד לקוח

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=duchan-media
NEXT_PUBLIC_R2_PUBLIC_URL=      # https://media.duchan.co
# R2_ENDPOINT=                  # override אופציונלי — לבדיקות מקומיות / ספק S3 אחר

# אדמין — אימיילים מופרדים בפסיק
ADMIN_EMAILS=

# סוד לקרון היומי (גיבוי + פינג)
CRON_SECRET=

# הפעלת חנות — תשלום חד-פעמי. הילדה בונה בחינם; הלינק נפתח בהפעלה.
NEXT_PUBLIC_ACTIVATION_PRICE=200
NEXT_PUBLIC_OWNER_WHATSAPP=      # E.164 בלי + (972…) — לביט ידני ולשיחה עם המנהלת
NEXT_PUBLIC_PAY_BIT_URL=         # לינק תשלום אישי בביט (אופציונלי)
NEXT_PUBLIC_PAY_PAYBOX_URL=      # לינק תשלום אישי בפייבוקס (אופציונלי)

# פיצ'ר פרימיום: כתיבת תיאורי מוצר ע"י AI (אופציונלי)
ANTHROPIC_API_KEY=
AI_MODEL=                       # ברירת מחדל claude-opus-5; claude-haiku-4-5 זול פי ~5

# הכתובת הפומבית — נדרשת לתצוגה מקדימה בוואטסאפ (OpenGraph)
NEXT_PUBLIC_SITE_URL=          # https://<הדומיין שלך> — חובה בפרודקשן
